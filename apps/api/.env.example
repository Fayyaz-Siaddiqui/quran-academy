# ───────── Runtime ─────────
NODE_ENV=development
PORT=4000
# Number of reverse proxies in front of the API (nginx/Cloudflare) — needed for correct client IPs & rate limits
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false

# ───────── URLs ─────────
# Where the Next.js app lives (used in email links)
APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Production: ".yourdomain.com" so app.yourdomain.com can send the refresh cookie to api.yourdomain.com
COOKIE_DOMAIN=

# ───────── Data ─────────
DATABASE_URL=postgresql://quran:quran@localhost:5432/quran_academy?schema=public
REDIS_URL=redis://localhost:6379

# ───────── Secrets (generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ─────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_CHALLENGE_SECRET=change-me-to-another-long-random-string-32-chars
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# ───────── Tenancy ─────────
DEFAULT_ACADEMY_SLUG=main

# ───────── Email (leave SMTP_HOST empty in dev to log emails to the console) ─────────
MAIL_FROM="Quran Academy <no-reply@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ───────── Storage: Cloudflare R2 (S3-compatible) or AWS S3 ─────────
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; leave empty for AWS S3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ───────── Zoom Video SDK ─────────
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
CLASS_JOIN_WINDOW_MINUTES=10

# ───────── Seeder ─────────
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=
SEED_ACADEMY_NAME="Al-Noor Online Quran Academy"
SEED_DEMO=false
SEED_DEMO_PASSWORD=DemoPass12345
